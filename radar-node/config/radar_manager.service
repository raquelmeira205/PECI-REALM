[Unit]
Description=Radar Connection Manager & Failover
After=network.target network-online.target syslog.target wpa_supplicant.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/pi/realm-node
ExecStart=/usr/bin/python3 /home/pi/realm-node/radar_manager.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=radar_manager

[Install]
WantedBy=multi-user.target
